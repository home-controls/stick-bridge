CONFIG_IDF_TARGET="esp32p4"
# This board's P4 is rev 1.3: builds for rev 3.x won't boot on it
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_FREERTOS_HZ=1000

# Console on UART0 = the Type-C port (CH343P)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Two app slots + rollback: an update from the web page boots on trial and is kept only if it works
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Ethernet only
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_LWIP_LOCAL_HOSTNAME="zigbee-eth-bridge"
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# Bridge (listen + client for each of 4 radios), web server (listen + ctrl + 12), mDNS, SNTP, headroom
CONFIG_LWIP_MAX_SOCKETS=32

# Web server: the dashboard + API, with room for long URIs and headers (basic auth)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

# mDNS without its console command
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# Panic: keep the reason in RTC memory so the dashboard can show why it last rebooted
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# A hung idle task (something spinning) restarts the board instead of leaving Zigbee2MQTT stranded
CONFIG_ESP_TASK_WDT_PANIC=y

# Plain log lines (the dashboard's live log parses them)
CONFIG_LOG_COLORS=n

# Updates over HTTPS (GitHub and whatever source is set): the common CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_TLS_USING_MBEDTLS=y

# microSD log copy (sdlog.c): long file names (2026-11-24.log); FAT32 only (no exFAT in ESP-IDF)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# PSRAM: the P4NRW32X's 32 MB in-package PSRAM (hex mode; 200 MHz is the most a rev 1.x chip allows).
# Allocations over 4 KB (stream buffers, HTTP, TLS) go there; small ones, task stacks and DMA buffers
# (USB, Ethernet) stay in internal RAM. A board without working PSRAM still boots (IGNORE_NOTFOUND).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# No 32 MB memory test at every boot: it lengthens each reboot (and Zigbee2MQTT's outage)
CONFIG_SPIRAM_MEMTEST=n

# Radio sticks behind a USB hub on J3 (dongle.c / radio_core.c). One hub level: a stick is known by its hub port.
# J3 is made full-speed-only at runtime (settings usb_fs_only), so a USB 2.0/3.0 hub runs at full speed and the
# full-speed sticks behind it need no transaction translator, which the P4 doesn't have.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=n

# Release build: optimise for size (-Os, the ESP-IDF production setting) instead of -Og debug code.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Nothing on the P4's USB-Serial-JTAG (the Type-C port is the CH343 UART): don't write every log line there too.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Only TLS client connections (updates, firmware downloads), no DHCP server, mDNS on Ethernet only, no browsing.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_LWIP_DHCPS=n
CONFIG_MDNS_PREDEF_NETIF_STA=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_ENABLE_BROWSE=n
# lwIP's buffers (TCP queues, sockets) in PSRAM first: the Ethernet driver copies into its own DMA buffers
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
